    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        $(document).ready(function(){
            // Back to Top Button
            $(window).scroll(function(){
                if ($(this).scrollTop() > 300) {
                    $('#backToTop').removeClass('opacity-0 invisible').addClass('opacity-100 visible');
                } else {
                    $('#backToTop').removeClass('opacity-100 visible').addClass('opacity-0 invisible');
                }
            });
            
            $('#backToTop').click(function(e){
                e.preventDefault();
                $('html, body').animate({scrollTop: 0}, 800);
                return false;
            });
            
            // Smooth scrolling for anchor links
            $('a[href*="#"]').on('click', function(e) {
                e.preventDefault();
                $('html, body').animate(
                    {
                        scrollTop: $($(this).attr('href')).offset().top - 80,
                    },
                    500,
                    'linear'
                );
            });
            
            // Animate elements on scroll
            function animateOnScroll() {
                $('.animate__animated').each(function() {
                    var position = $(this).offset().top;
                    var scroll = $(window).scrollTop();
                    var windowHeight = $(window).height();
                    if (scroll + windowHeight > position + 100) {
                        $(this).addClass($(this).data('animate'));
                    }
                });
            }
            
            animateOnScroll();
            $(window).scroll(function() {
                animateOnScroll();
            });
            
            // Carousel animations
            $('#myCarousel').on('slide.bs.carousel', function () {
                $('.carousel-caption').removeClass('animate__fadeInLeft animate__fadeInRight animate__fadeIn');
            });
            
            $('#myCarousel').on('slid.bs.carousel', function () {
                var activeIndex = $('.carousel-item.active').index();
                var caption = $('.carousel-item.active .carousel-caption');
                if (activeIndex === 0) {
                    caption.addClass('animate__fadeInLeft');
                } else if (activeIndex === 2) {
                    caption.addClass('animate__fadeInRight');
                } else {
                    caption.addClass('animate__fadeIn');
                }
            });

            // Chatbot functionality
            const chatbotToggle = $('#chatbotToggle');
            const chatbotWindow = $('#chatbotWindow');
            const closeChat = $('#closeChat');
            const chatbotInput = $('#chatbotInput');
            const chatbotSend = $('#chatbotSend');
            const chatbotBody = $('#chatbotBody');

            // Toggle chatbot window
            chatbotToggle.click(function() {
                chatbotWindow.toggleClass('active');
                if (chatbotWindow.hasClass('active')) {
                    chatbotInput.focus();
                }
            });

            closeChat.click(function() {
                chatbotWindow.removeClass('active');
            });

            // Show typing indicator
            function showTyping() {
                chatbotBody.append(`
                    <div class="chatbot-message bot" id="typingIndicator">
                        <div class="typing-indicator">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    </div>
                `);
                scrollToBottom();
            }

            // Remove typing indicator
            function hideTyping() {
                $('#typingIndicator').remove();
            }

            // Scroll to bottom of chat
            function scrollToBottom() {
                chatbotBody.scrollTop(chatbotBody[0].scrollHeight);
            }

            // Generate bot response
            function generateBotResponse(userMessage) {
                const lowerMsg = userMessage.toLowerCase();
                
                if (/hello|hi|hey|greetings/i.test(lowerMsg)) {
                    return "Hello there! How can I help you with Bytmos today?";
                }
                else if (/download|install|app|get started/i.test(lowerMsg)) {
                    return `
                        You can download the Bytmos app from:<br><br>
                        <strong>Android:</strong> <a href="#download">Google Play Store</a><br>
                        <strong>iOS:</strong> <a href="#download">Apple App Store</a><br><br>
                        The app is free to download and use!
                    `;
                }
                else if (/partner|join|provider|become|sign up/i.test(lowerMsg)) {
                    return `
                        To become a Bytmos Partner:<br><br>
                        1. Download the Bytmos app<br>
                        2. Create a provider account<br>
                        3. Complete your profile verification<br>
                        4. Start offering your services!<br><br>
                        <a href="#partner">Learn more about our partnership program</a>
                    `;
                }
                else if (/service|offer|feature|what.*do|provide/i.test(lowerMsg)) {
                    return `
                        Bytmos offers these professional services:<br><br>
                        <strong>Technology Services:</strong> Web development, app development, IT support<br>
                        <strong>Design & Art:</strong> Graphic design, illustrations, UI/UX<br>
                        <strong>Home Maintenance:</strong> Repairs, cleaning, organization<br>
                        <strong>Business Solutions:</strong> Consulting, marketing, virtual assistance<br><br>
                        All provided by verified professionals!
                    `;
                }
                else if (/contact|support|help|email|phone|call/i.test(lowerMsg)) {
                    return `
                        For direct support, you can:<br><br>
                        <strong>Email:</strong> support@bytmos.com<br>
                        <strong>Phone:</strong> +1 (555) 123-4567<br>
                        <strong>Website:</strong> <a href="https://bytmos.com/support" target="_blank">bytmos.com/support</a><br><br>
                        Our support team is available 24/7.
                    `;
                }
                else if (/thank|thanks|appreciate/i.test(lowerMsg)) {
                    return "You're welcome! Is there anything else I can help you with?";
                }
                else if (/bye|goodbye|see you/i.test(lowerMsg)) {
                    return "Goodbye! Feel free to come back if you have more questions. Have a great day!";
                }
                else {
                    return `
                        I'm not sure I understand. I can help with:<br><br>
                        • Downloading our app<br>
                        • Partnership information<br>
                        • Service offerings<br>
                        • Account support<br><br>
                        Could you please rephrase your question?
                    `;
                }
            }

            // Handle sending messages
            function sendMessage() {
                const message = chatbotInput.val().trim();
                if (message) {
                    // Add user message
                    chatbotBody.append(`
                        <div class="chatbot-message user">
                            <div class="message-bubble">${message}</div>
                        </div>
                    `);

                    // Clear input
                    chatbotInput.val('');
                    scrollToBottom();
                    
                    // Show typing indicator
                    showTyping();
                    
                    // Generate bot response after delay
                    setTimeout(() => {
                        hideTyping();
                        const botResponse = generateBotResponse(message);
                        
                        // Add bot response
                        chatbotBody.append(`
                            <div class="chatbot-message bot">
                                <div class="message-bubble">${botResponse}</div>
                            </div>
                        `);
                        
                        // Add quick replies if not ending conversation
                        if (!message.toLowerCase().includes('thank') && !message.toLowerCase().includes('bye')) {
                            chatbotBody.find('.chatbot-message').last().append(`
                                <div class="quick-replies">
                                    <div class="quick-reply-btn" data-reply="How do I download the app?">Download app</div>
                                    <div class="quick-reply-btn" data-reply="How to become a partner?">Become partner</div>
                                    <div class="quick-reply-btn" data-reply="What services do you offer?">Services</div>
                                </div>
                            `);
                        }
                        
                        scrollToBottom();
                    }, 1000 + Math.random() * 1500); // Random delay between 1-2.5 seconds
                }
            }

            // Send message on button click
            chatbotSend.click(sendMessage);
            
            // Send message on Enter key
            chatbotInput.on('keypress', function(e) {
                if (e.which === 13) {
                    sendMessage();
                }
            });
            
            // Handle quick reply buttons
            chatbotBody.on('click', '.quick-reply-btn', function() {
                const replyText = $(this).data('reply');
                chatbotInput.val(replyText);
                sendMessage();
            });
        });
    </script>
</body>
</html>